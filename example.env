# Copy this file to .env for local Docker or uvicorn runs.
VELACORE_APP_NAME=api_velacore
VELACORE_APP_VERSION=0.1.0

# Required only for Twelve Data-backed endpoints.
# VELACORE_TWELVE_DATA_API_KEY=your-api-key

# Internal container port used by Uvicorn.
PORT=8000

# Host port exposed by Docker Compose.
HOST_PORT=8091
